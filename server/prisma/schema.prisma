// Meeto database schema.
//
// LOCAL DEV / DEMO: SQLite (no infra needed).
// PRODUCTION: switch `provider` to "postgresql" and set DATABASE_URL; then
// regenerate migrations. String status fields map to Postgres enums at that
// point (Prisma enums are not supported on SQLite).
//
// MONEY: all amounts are integer minor units (centavos, PHP).
// RATES: basis points (1000 = 10%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  phone      String   @unique // E.164, login identity (OTP)
  name       String
  gender     String // MALE | FEMALE
  role       String   @default("USER") // USER | ADMIN
  // ACTIVE | BANNED. A banned account fails every authenticated request
  // immediately (checked in the auth guard), so a ban needs no token expiry.
  status     String   @default("ACTIVE")
  avatarUrl  String   @default("")
  meta       String   @default("")
  bio        String   @default("")
  birthDate  DateTime? // age is derived, never stored
  country    String   @default("") // launch markets: Philippines | Indonesia | Vietnam
  city       String   @default("")
  job        String   @default("") // picked from a fixed category list client-side
  education  String   @default("") // picked from a fixed level list client-side
  heightCm   Int?
  weightKg   Int?
  tagsJson   String   @default("[]") // JSON array of interest tags
  // JSON array of scene tags a HOST offers (picked at registration); the
  // host detail price list and invitation validation read from it.
  photosJson String   @default("[]") // JSON array of photo URLs
  // NONE | PENDING | VERIFIED. Real-person verification; currently a mock
  // provider that approves instantly, later a real KYC vendor.
  verificationStatus    String   @default("NONE")
  verificationSelfieUrl String   @default("")
  createdAt  DateTime @default(now())

  posts          Post[]
  applications   Application[]
  ordersAsPayer  Order[]       @relation("payer")
  ordersAsEarner Order[]       @relation("earner")
  ledgerEntries  LedgerEntry[]
  withdrawals    Withdrawal[]
  messages       Message[]
  invitationsSent     Invitation[] @relation("inviter")
  invitationsReceived Invitation[] @relation("invitedHost")
  proposals           Proposal[]
  reportsFiled        Report[]
}

// An in-room safety report. While a report is OPEN the order's automatic
// settlement is held (the community guidelines promise exactly that), so
// ops can refund or release deliberately.
model Report {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  reason     String
  status     String   @default("OPEN") // OPEN | RESOLVED
  createdAt  DateTime @default(now())

  @@index([status])
}

// A HOST's standing activity pitch ("let's catch a live gig"), the supply
// side of the two-sided board: demand posts live in the gig hall, proposals
// lead the user home feed. Deliberately loose — no time or place — because
// users buy the idea; the concrete plan still comes through the standard
// order plan flow after the invitation is accepted and paid.
model Proposal {
  id        String   @id @default(cuid())
  hostId    String
  host      User     @relation(fields: [hostId], references: [id])
  title       String
  description String   @default("") // optional elaboration, mirrors demand posts
  sceneTag    String // bound to the host's offered scenes, drives pricing
  imageUrl    String   @default("") // cover photo, optional
  // The platform activity template the pitch was launched from: scene,
  // cover, district and meeting point all resolve from it.
  templateId  String   @default("")
  // District snapshot from the template (e.g. "Makati").
  area      String   @default("")
  // The host's rough availability window: the pitch is a service shelf
  // listing, not a scheduled event. Inviters pick the concrete time (and
  // the price tier) inside this window; selection locks it.
  timeSlot  String   @default("ANYTIME") // ANYTIME | NOON | EVENING
  // Mirrors Post.status: OPEN takes invitations; selecting one moves it to
  // PENDING_PAYMENT, payment to MATCHED; a cancelled order reopens it.
  status    String   @default("OPEN") // OPEN | PENDING_PAYMENT | MATCHED | COMPLETED | CANCELLED
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A USER's invitation on a HOST's proposal: the exact mirror of a host
// signing up on a user's demand post. Several users may invite the same
// proposal; the host picks one, which creates a direct post + selected
// application + order awaiting payment, so everything downstream reuses
// the standard order flow.
model Invitation {
  id          String    @id @default(cuid())
  // The proposal this invitation answers; invitations only start from a
  // concrete pitch (the product trades activities, not people).
  proposalId  String    @default("")
  fromUserId  String
  from        User      @relation("inviter", fields: [fromUserId], references: [id])
  hostId      String
  host        User      @relation("invitedHost", fields: [hostId], references: [id])
  sceneTag    String
  // Activity budget tier the inviter picked; snapshotted so repricing
  // never changes a pending invitation.
  budgetMinor Int       @default(0)
  // The concrete meeting time the inviter picked, inside the pitch's
  // availability window and the host working hours. Selection turns this
  // into the order's plan time.
  scheduledAt DateTime?
  note        String    @default("")
  status      String    @default("PENDING") // PENDING | ACCEPTED
  postId      String    @default("") // set when selected
  orderId     String    @default("") // set when selected
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([proposalId, status])
  @@index([fromUserId, createdAt])
}

// Single-row (id = 1) platform pricing. Adjustable at runtime via the admin
// API; posts snapshot the fee at publish time so repricing never affects
// existing posts or orders.
model PricingConfig {
  id                Int      @id @default(1)
  platformFeeRateBp Int
  defaultFeeMinor   Int
  sceneBudgetTiersJson     String // JSON object: scene tag -> fee minor units
  updatedAt         DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  // DEMAND: an activity request that hosts can sign up for (the
  // transactional post). MOMENT: a community photo/text recap of a
  // completed activity; never transactional.
  type        String   @default("DEMAND")
  sceneTag    String
  title       String
  description String   @default("")
  detail      String   @default("")
  // The platform activity template this post was published from. The
  // meeting point, venue and duration label resolve from it; empty on
  // MOMENT recaps.
  templateId  String   @default("")
  // The concrete meeting time the publisher picked. Duration is the
  // platform standard, so this fully schedules the activity.
  scheduledAt DateTime?
  // District snapshot from the template (e.g. "Makati").
  area        String   @default("")
  imageUrl    String   @default("")
  imagesJson  String   @default("[]") // JSON array of photo URLs (moments)
  // Venue name on MOMENT recaps (e.g. a cafe name); recommendation content,
  // required at publish. Empty on demand posts.
  venue       String   @default("")
  status      String   @default("OPEN") // OPEN | PENDING_PAYMENT | MATCHED | COMPLETED | CANCELLED
  // Who covers on-site expenses (food, drinks...): TREAT = the publisher
  // treats; AA = everyone pays their own. Distinct from the hosting fee.
  expensePolicy String @default("TREAT") // TREAT | AA
  // FEED: publicly listed in the community. DIRECT: backing post of a
  // private invitation deal; never shown in the community feed.
  origin      String   @default("FEED")
  // Set on DIRECT posts born from selecting an invitation on a proposal:
  // the order lifecycle mirrors its status back onto that proposal.
  proposalId  String   @default("")
  feeMinor    Int // snapshot of the platform fee at publish time
  createdAt   DateTime @default(now())

  applications Application[]
  orders       Order[]
}

model Application {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id])
  applicantId String
  applicant   User     @relation(fields: [applicantId], references: [id])
  status      String   @default("APPLIED") // APPLIED | SELECTED | RELEASED
  // Sign-up carries no plan: the activity (venue, meeting point, time,
  // duration) is fully fixed by the template and the post, so applying is
  // a one-tap confirmation and selection is purely about the person.
  createdAt   DateTime @default(now())

  @@unique([postId, applicantId])
}

model Order {
  id              String   @id @default(cuid())
  postId          String
  post            Post     @relation(fields: [postId], references: [id])
  payerId         String // always the poster (who requested the activity)
  payer           User     @relation("payer", fields: [payerId], references: [id])
  earnerId        String // always the selected host
  earner          User     @relation("earner", fields: [earnerId], references: [id])
  status          String   @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | ACTIVE | COMPLETED | CANCELLED | FORFEITED
  feeMinor        Int
  commissionMinor Int // round(feeMinor * rateBp / 10000), fixed at creation
  netMinor        Int // feeMinor - commissionMinor (exact sum guaranteed)

  // The concrete plan (place + time). Selection orders inherit it from the
  // sign-up plan card already approved; invitation orders get it from the
  // host after payment. Chat opens at payment either way; the confirmed
  // plan just becomes the order's effective place and time.
  planPlace       String    @default("")
  planLat         Float     @default(0)
  planLng         Float     @default(0)
  planAt          DateTime?
  // The itinerary: what the activity actually covers, step by step.
  planNote        String    @default("")
  // How long the activity is planned to run.
  planDurationMinutes Int   @default(0)
  planProposedAt  DateTime?
  planConfirmedAt DateTime?

  // Per-side read cursors for the order's chat. Reading the message list
  // advances the caller's cursor; the conversation list counts the other
  // side's messages past it as unread. Null = never opened the room.
  payerLastReadAt  DateTime?
  earnerLastReadAt DateTime?

  // Proof of meeting: a 4-digit code generated with the order and shown
  // only to the payer. The host asks for it in person and submits it to
  // start the service; the escrow settles automatically once the started
  // service runs its planned duration. If nobody ever submits the code,
  // the order forfeits: the money goes to neither side.
  meetCode        String    @default("")
  paidAt          DateTime?
  startedAt       DateTime?

  // Settlement: the poster completes the activity single-sidedly, or the
  // escrow auto-settles once the confirmed plan time plus the grace delay
  // has passed (lazy, on reads).
  completedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments      Payment[]
  ledgerEntries LedgerEntry[]
  messages      Message[]
  reports       Report[]
}

// Order-scoped chat between the two matched parties. Interim transport
// until the IM provider is integrated: clients poll for new messages. The
// shape (order-scoped, sender + text) survives the IM migration.
model Message {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  // TEXT carries plain chat in [text]. PLAN is the plan card sent into the
  // stream: [text] then holds a JSON snapshot {place, scheduledAt, note}
  // frozen at send time, so re-proposals never rewrite history.
  kind      String   @default("TEXT")
  text      String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// One row per charge attempt against a payment channel. The demo provider
// is MOCK; a real channel (gcash/maya/cards) slots in behind the same
// interface without touching order logic.
model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  amountMinor Int
  provider    String   @default("MOCK")
  status      String // SUCCEEDED | REFUNDED
  createdAt   DateTime @default(now())
}

// Append-only money movements. Every business event posts a balanced set of
// entries (sum = 0 across accounts for settlements), so balances are always
// derivable and auditable.
model LedgerEntry {
  id          String   @id @default(cuid())
  account     String // PLATFORM_ESCROW | PLATFORM_REVENUE | USER_WALLET
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  amountMinor Int // signed
  entryType   String // ESCROW_IN | ESCROW_RELEASE | ESCROW_REFUND | SETTLE_NET | SETTLE_COMMISSION | WITHDRAWAL
  createdAt   DateTime @default(now())

  @@index([account, userId])
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountMinor Int
  status      String   @default("PENDING") // PENDING | PAID
  createdAt   DateTime @default(now())
}